}
</style>


<script> 

// Timeline reveal
const timelineItems = document.querySelectorAll('.timeline-item');
const timelineObserver = new IntersectionObserver((entries) => {
  entries.forEach((entry, i) => {
    if (entry.isIntersecting) {
      setTimeout(() => {
        entry.target.classList.add('visible');
      }, 100);
      timelineObserver.unobserve(entry.target);
    }
  });
}, { rootMargin: '0px 0px -60px 0px' });

timelineItems.forEach(item => timelineObserver.observe(item));

// Home page scroll spy
const homeNavLinks = document.querySelectorAll('.page-nav a');
const homeSections = document.querySelectorAll('#about, #research, #experience, #education, #publications, #skills');

let activeSection = null;

window.addEventListener('scroll', () => {
  let closest = null;
  let closestDistance = Infinity;

  homeSections.forEach(section => {
    const rect = section.getBoundingClientRect();
    const distance = Math.abs(rect.top - window.innerHeight * 0.3);
    if (distance < closestDistance) {
      closestDistance = distance;
      closest = section;
    }
  });

  if (closest && closest.id !== activeSection) {
    activeSection = closest.id;
    homeNavLinks.forEach(link => {
      link.classList.remove('active');
      if (link.getAttribute('href') === '#' + activeSection) {
        link.classList.add('active');
      }
    });
  }
}, { passive: true });
</script>

<style>
  .glow {
    position: absolute;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(180,140,60,0.07) 0%, transparent 65%);
    top: -120px;
    right: -60px;
    pointer-events: none;
  }
  .hero-wrap {
    position: relative;
    padding-left: 200px; /* clears the 160px nav + its left offset */
  }
  @media (max-width: 1100px) {
    .hero-wrap {
      padding-left: 0;
    }
  }
  .hero {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 24px;
    align-items: start;
  }
.bg-initials {
  position: fixed;
  bottom: 90px;
  left: 48%;
  transform: translateX(-50%);
  font-family: var(--font-serif);
  font-size: clamp(220px, 60vw, 700px);
  font-weight: 700;
  color: transparent;
  -webkit-text-stroke: 1px rgba(212, 183, 86, 0.13);
  letter-spacing: -10px;
  line-height: 1;
  pointer-events: none;
  user-select: none;
  z-index: 0;
}

@media (max-width: 600px) {
  .bg-initials {
    font-size: 180px;
    bottom: -20px;
    letter-spacing: -5px;
  }
}

  .page-nav {
  position: fixed;
  top: 80px;
  left: 30px;
  width: 160px;
  padding: 20px 16px;
  background: rgba(255, 255, 255, 0.17);
  border: 0.5px solid rgba(196,160,80,0.15);

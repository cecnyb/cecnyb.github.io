  }

  @media (max-width: 860px) {
    .slide-inner { grid-template-columns: 1fr; }
    .slide-art { height: 160px; }
  }
</style>

<script>
  (function(){
    const slides = document.getElementById('slides');
    const dots = Array.from(document.querySelectorAll('.dot'));
    const prev = document.getElementById('prev');
    const next = document.getElementById('next');
    const total = slides.children.length;
    let index = 0;
    let auto = null;

    function setIndex(i){
      index = (i + total) % total;
      slides.style.transform = `translateX(${-index * 100}%)`;
      dots.forEach((d, k) => {
        d.setAttribute('aria-current', k === index ? 'true' : 'false');
        d.setAttribute('aria-selected', k === index ? 'true' : 'false');
      });
    }

    function startAuto(){
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      stopAuto();
      auto = setInterval(() => setIndex(index + 1), 2900);
    }
    function stopAuto(){ if(auto) clearInterval(auto); }

    prev.addEventListener('click', () => { setIndex(index - 1); startAuto(); });
    next.addEventListener('click', () => { setIndex(index + 1); startAuto(); });
    dots.forEach((d, k) => d.addEventListener('click', () => { setIndex(k); startAuto(); }));

    document.addEventListener('keydown', (e) => {
      if(e.key === 'ArrowLeft') { setIndex(index - 1); startAuto(); }
      if(e.key === 'ArrowRight') { setIndex(index + 1); startAuto(); }
    });

    let startX = null;
    slides.addEventListener('touchstart', e => { startX = e.touches[0].clientX; stopAuto(); }, {passive: true});
    slides.addEventListener('touchend', e => {
      if(startX === null) return;
      const dx = e.changedTouches[0].clientX - startX;
      startX = null;
      if(Math.abs(dx) > 40) setIndex(index + (dx < 0 ? 1 : -1));
      startAuto();
    });

    document.querySelector('.carousel').addEventListener('mouseenter', stopAuto);
    document.querySelector('.carousel').addEventListener('mouseleave', startAuto);

    setIndex(0);
    startAuto();

    // Video modal
    const openDemoButtons = document.querySelectorAll('.open-skincare-demo');
    const modal = document.getElementById('skincare-demo-modal');
    const closeDemoButton = document.getElementById('close-skincare-demo');
    const closeBackdrop = document.getElementById('close-skincare-demo-backdrop');
    const video = document.getElementById('skincare-demo-video');

    function openModal() { modal.classList.add('is-open'); modal.setAttribute('aria-hidden', 'false'); }
    function closeModal() { modal.classList.remove('is-open'); modal.setAttribute('aria-hidden', 'true'); video.pause(); video.currentTime = 0; }

    openDemoButtons.forEach(b => b.addEventListener('click', openModal));
    closeDemoButton.addEventListener('click', closeModal);
    closeBackdrop.addEventListener('click', closeModal);
    document.addEventListener('keydown', e => { if(e.key === 'Escape' && modal.classList.contains('is-open')) closeModal(); });
  })();

  // Scroll spy for sidebar
const navLinks = document.querySelectorAll('.projects-nav a');
const cards = document.querySelectorAll('.project-card');

const observer = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (entry.isIntersecting) {
      navLinks.forEach(link => {
        link.classList.remove('active');
        if (link.getAttribute('href') === '#' + entry.target.id) {
          link.classList.add('active');
        }
      });
    }
  });
}, { rootMargin: '-40% 0px -40% 0px', threshold: 0 });

cards.forEach(card => observer.observe(card));

// Scroll reveal for project cards
// 3D scroll focus effect
const focusObserver = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (entry.isIntersecting) {
      entry.target.classList.add('in-focus');
      entry.target.classList.remove('out-focus');
    } else {
      entry.target.classList.remove('in-focus');
      entry.target.classList.add('out-focus');
    }
  });
}, { rootMargin: '-40% 0px -20% 0px', threshold: 0 });

cards.forEach(card => focusObserver.observe(card));
</script>